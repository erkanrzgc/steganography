# Copy to .env (gitignored) and fill in real values.
# Any AI provider integration reads its key via config.get_secret().
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# REST API (required for non-loopback bind)
STEGANO_API_KEY=
STEGANO_STATE_DIR=
STEGANO_ALLOW_AI_FILE_UPLOAD=0
STEGANO_MAX_UPLOAD_BYTES=52428800
STEGANO_MAX_BATCH_FILES=20
STEGANO_MAX_BATCH_BYTES=209715200
